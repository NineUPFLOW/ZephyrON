<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        «Breeze Light» — основная светлая тема Zephyron и запас, если папки
        themes нет. Ключи те же до последнего, что в Palette.xaml и Light.xaml:
        стили в Controls.xaml опираются только на них и про тему не знают.
        Поэтому переключение — это подмена одного словаря, а не второй набор
        стилей, который пришлось бы править парами.

        Направление: минимализм, много воздуха, мягкие нейтральные тона,
        один фиолетовый акцент. Смысл цветов состояния ровно тот же, что
        и в прочих темах: акцент — «работает», красный — «закрыто», жёлтый —
        «требует внимания». Перекрашены оттенки, а не роли.

        Оттенки акцента, опасности и внимания темнее исходных значений
        палитры задания намеренно: ThemeContrast требует 4.5:1 для текста
        на подложке, карточке и поле, и на белом исходные #7565E8 / #D95464 /
        #D99A32 давали 4.39 / 3.89 / 2.44 — три пары из пятнадцати провалены,
        и тема не применилась бы вовсе. Замер 19.10: акцент #6558E0 — 4.87
        на подложке, опасность #C43D50 — 4.74, внимание #8A5A00 — 5.53.

        Значения совпадают с themes/breeze/theme.json — расхождение ловит тест
        ThemeFilesMatchXamlPalettes.
    -->

    <Color x:Key="BackdropColor">#FFF5F7FC</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="RaisedColor">#FFF0F3FA</Color>
    <Color x:Key="BorderColor">#FFE3E8F2</Color>

    <Color x:Key="TextColor">#FF20243A</Color>
    <Color x:Key="MutedColor">#FF616A82</Color>
    <Color x:Key="FaintColor">#FF8A93A8</Color>

    <Color x:Key="AccentColor">#FF6558E0</Color>
    <Color x:Key="AccentDimColor">#FFA49AF8</Color>
    <Color x:Key="DangerColor">#FFC43D50</Color>
    <Color x:Key="WarnColor">#FF8A5A00</Color>

    <!--
        Заливки отдельно от текста: на светлом фоне одно значение не может
        служить обоим. Тёмная заливка кнопки с тёмной же подписью сливается
        в грязь, а зелёный, читаемый как текст на белом, должен быть тёмным.
    -->
    <Color x:Key="AccentFillColor">#FF6558E0</Color>
    <Color x:Key="OnAccentColor">#FFFFFFFF</Color>
    <Color x:Key="WarnFillColor">#FFC77F1E</Color>

    <SolidColorBrush x:Key="Backdrop" Color="{StaticResource BackdropColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDim" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />

    <SolidColorBrush x:Key="AccentFill" Color="{StaticResource AccentFillColor}" />
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="WarnFill" Color="{StaticResource WarnFillColor}" />

    <!--
        Segoe UI — системный и на своём месте самый читаемый; Comfortaa
        запасом, если её нет. Моноширинный держит цифры в таблицах ровно.
    -->
    <FontFamily x:Key="UiFont">Segoe UI, Comfortaa</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Semibold, Segoe UI</FontFamily>

    <!--
        Фон окна для тем с картинкой (Themes.cs). У встроенных картинки нет:
        слой прозрачен, затемнение сплошное, меню — цвета подложки.
    -->
    <SolidColorBrush x:Key="BackdropImage" Color="Transparent" />
    <sys:Double x:Key="BackdropDim">1</sys:Double>
    <SolidColorBrush x:Key="Chrome" Color="{StaticResource BackdropColor}" />
    <SolidColorBrush x:Key="RailFill" Color="{StaticResource BackdropColor}" />
    <!-- Арт сбоку на «Главной» (Themes.cs): у встроенных тем картинки нет, колонка пуста. -->
    <SolidColorBrush x:Key="SideArt" Color="Transparent" />
    <ScaleTransform x:Key="UiScaleTransform" ScaleX="1" ScaleY="1" />

</ResourceDictionary>
