<Window x:Class="Zephyron.Gui.Views.FolderNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="clr-namespace:Zephyron.Gui"
        Title="Папка" Width="480" SizeToContent="Height" MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Backdrop}"
        ResizeMode="NoResize">

    <!--
        Папка — только вид (RouteFolders, 13.10): маршрут, положенный в неё,
        идёт туда же, куда шёл. Окно постоянного размера, как «имя списка».
    -->
    <!--
        Прокрутка на случай, когда окно выше экрана: при масштабе
        Windows 200 % оно вдвое выше обычного, и нижние кнопки ушли бы
        за край без всякой возможности до них добраться.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" LayoutTransform="{DynamicResource UiScaleTransform}">
        <StackPanel Margin="28,24,28,24">
            <TextBlock x:Name="Head" Style="{StaticResource DialogTitle}" TextWrapping="Wrap" />

            <TextBlock x:Name="Note" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Папка собирает маршруты вместе. Куда идёт каждый маршрут, она не меняет. Пустая папка исчезнет сама." />

            <TextBlock x:Name="NameLabel" Text="Название папки" FontWeight="SemiBold" Margin="0,18,0,6" />

            <TextBox x:Name="NameBox" KeyDown="OnKey" gui:Hint.Text="например, Игры" />

            <TextBlock x:Name="Problem" Style="{StaticResource Caption}" Margin="0,8,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource Ghost}" Content="Отмена" IsCancel="True"
                        Margin="0,0,8,0" Click="OnCancel" />
                <Button x:Name="Confirm" Style="{StaticResource Primary}" Content="Создать" IsDefault="True"
                        Click="OnCreate" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
