<UserControl x:Class="Zephyron.Gui.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Zephyron.Gui"
             xmlns:views="clr-namespace:Zephyron.Gui.Views"
             Background="{DynamicResource Chrome}">

    <UserControl.Resources>
        <!--
            Крупная карточка режима работы. По референсу «Режим работы» —
            три равноправные плитки с иконкой, названием и пояснением,
            а выбранная обведена акцентом и подсвечена. Прежде это были
            три тонких сегмента в одну строку: выбор читался как переключатель
            размера, а не как выбор того, ради чего программа написана.
        -->
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shape" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1.5"
                                CornerRadius="{StaticResource RLg}" Padding="16,15">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Shape" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                                <Setter TargetName="Shape" Property="Effect" Value="{StaticResource CardShadow}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка «подписи нет»: заголовок, значение, действие-кнопка. -->
        <Style x:Key="HomeCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,16" />
        </Style>
    </UserControl.Resources>

    <!--
        «Главная» по референсу: заголовок со ссылками, «Режим работы» тремя
        крупными карточками, сетка сведений и блок поддержки внизу.

        Состояния здесь нет — оно переехало в левую панель окна
        (ConnectionStatus): одно состояние на всё окно, а не два. Кнопка
        запуска тоже там: основное действие всегда на одном месте.
    -->
    <ScrollViewer Style="{StaticResource PageScroll}" Padding="{DynamicResource PagePad}"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMax}" />
            </Grid.ColumnDefinitions>

            <!--
                Сетка, а не стопка: сведения идут двумя колонками, как
                в референсе, а на узком окне колонки схлопываются в одну
                (HomeGrid, кодом — разметка одна).
            -->
            <StackPanel Grid.Column="0">

                <!-- Шапка раздела со ссылками на документацию, GitHub и канал. -->
                <ContentControl Style="{StaticResource PageHead}"
                                local:PageHead.Title="Главная"
                                local:PageHead.Subtitle="Режим работы и сведения о защите">
                    <WrapPanel VerticalAlignment="Center">
                        <Button Style="{StaticResource Ghost}" Click="OnDocs" Margin="0,0,8,4"
                                ToolTip="Описание программы на GitHub">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE82D;" Margin="0,0,8,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Документация" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Ghost}" Click="OnGitHub" Margin="0,0,8,4"
                                ToolTip="Исходники, выпуски, вопросы и обсуждения">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE943;" Margin="0,0,8,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="GitHub" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Ghost}" Click="OnTelegram" Margin="0,0,0,4"
                                ToolTip="Новости в телеграм-канале: что вышло и зачем обновляться, коротко">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE724;" Margin="0,0,8,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Telegram" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </ContentControl>

                <!--
                    Вышла новая версия (UpdateNotice). Первым блоком: её видно
                    при первом взгляде, а не только тем, кто дошёл вниз.
                -->
                <Border x:Name="UpdateCard" Style="{StaticResource Card}" Margin="0,0,0,16"
                        BorderBrush="{DynamicResource Accent}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock x:Name="UpdateWhat" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Style="{StaticResource Ghost}" Content="Что нового"
                                    Click="OnUpdateNotes" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Ghost}" Content="Не сейчас"
                                    Click="OnUpdateLater" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Primary}" Content="Обновить"
                                    Click="OnUpdateNow" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!--
                    Режим работы — главный выбор страницы, поэтому первым блоком
                    и тремя крупными карточками.
                -->
                <TextBlock Text="Режим работы" Style="{StaticResource SectionTitle}" Margin="2,0,0,12" />

                <Grid x:Name="ModeGrid" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <RadioButton x:Name="ModeDesync" Grid.Column="0" Style="{StaticResource ModeCard}"
                                 GroupName="WorkMode" Tag="Desync" Click="OnMode">
                        <StackPanel>
                            <Border x:Name="ModeDesyncTile" Width="40" Height="40" CornerRadius="{StaticResource RMd}"
                                    Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource LineGlyph}" FontSize="19" Text="&#xE9E9;"
                                           Foreground="{DynamicResource Accent}" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ModeDesyncName" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="winws2: вмешивается в рукопожатие TLS так, что фильтр оператора не опознаёт имя. Трафик идёт напрямую, своим обычным путём, и адрес остаётся домашним.&#x0a;&#x0a;Лечит блокировки по имени и не лечит отказы по стране: сайт видит тот же адрес, что и без него." />
                            </StackPanel>
                            <TextBlock x:Name="ModeDesyncNote" Style="{StaticResource Caption}" Margin="0,7,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ModeTunnel" Grid.Column="2" Style="{StaticResource ModeCard}"
                                 GroupName="WorkMode" Tag="Tunnel" Click="OnMode">
                        <StackPanel>
                            <Border x:Name="ModeTunnelTile" Width="40" Height="40" CornerRadius="{StaticResource RMd}"
                                    Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource LineGlyph}" FontSize="19" Text="&#xE774;"
                                           Foreground="{DynamicResource Accent}" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ModeTunnelName" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="sing-box: поднимает сетевой адаптер и уводит через него трафик. Адрес становится зарубежным, и это лечит отказы по стране.&#x0a;&#x0a;В этом режиме забирает всё, кроме поставленного «напрямую», — как обычный VPN. Без исключений (настройки туннеля) — вообще всё.&#x0a;&#x0a;Требует подписки или WARP: без них поднимать нечего." />
                            </StackPanel>
                            <TextBlock x:Name="ModeTunnelNote" Style="{StaticResource Caption}" Margin="0,7,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ModeRoute" Grid.Column="4" Style="{StaticResource ModeCard}"
                                 GroupName="WorkMode" Tag="Route" Click="OnMode">
                        <StackPanel>
                            <Border x:Name="ModeRouteTile" Width="40" Height="40" CornerRadius="{StaticResource RMd}"
                                    Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource LineGlyph}" FontSize="19" Text="&#xE8AB;"
                                           Foreground="{DynamicResource Accent}" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ModeRouteName" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Оба движка сразу. Что названо в маршрутах «через VPN», уходит в туннель; остальное идёт напрямую, и закрытое по имени чинит десинк.&#x0a;&#x0a;Адрес для сайтов из маршрутов — зарубежный, для прочих — домашний: российские сервисы не видят VPN." />
                            </StackPanel>
                            <TextBlock x:Name="ModeRouteNote" Style="{StaticResource Caption}" Margin="0,7,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                </Grid>

                <!-- Движки выбранного режима: словами, тем же цветом, что точки в трее. -->
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ModeText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,14,0" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel x:Name="DesyncChip" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DesyncDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Faint}" />
                                <TextBlock Margin="7,0,0,0" FontSize="12" Foreground="{DynamicResource Text}" Text="Десинк" VerticalAlignment="Center" />
                                <TextBlock x:Name="DesyncState" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource Muted}" Text="—" VerticalAlignment="Center" />
                                <TextBlock x:Name="DesyncPid" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource IconGhost}" Content="&#xE713;" Margin="6,0,0,0"
                                        Padding="5,2" MinWidth="0" Click="OnDesyncSettings"
                                        ToolTip="Пресеты и рецепты — раздел «Десинк»" />
                            </StackPanel>

                            <StackPanel x:Name="TunnelChip" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Ellipse x:Name="TunnelDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Faint}" />
                                <TextBlock Margin="7,0,0,0" FontSize="12" Foreground="{DynamicResource Text}" Text="Туннель" VerticalAlignment="Center" />
                                <TextBlock x:Name="TunnelState" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource Muted}" Text="—" VerticalAlignment="Center" />
                                <TextBlock x:Name="TunnelPid" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource IconGhost}" Content="&#xE713;" Margin="6,0,0,0"
                                        Padding="5,2" MinWidth="0" Click="OnTunnelSettings"
                                        ToolTip="Настройки туннеля" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Жалоба на сочетание движков; пусто — строки нет вовсе, и отступа тоже. -->
                <TextBlock x:Name="EnginesLine" Style="{StaticResource Caption}"
                           Margin="4,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                <!-- Предупреждения: защитник в стеке, стёртый hosts. Пусто — не показываем. -->
                <ItemsControl x:Name="Warnings" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8"
                                    BorderBrush="{DynamicResource Warn}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" />
                                    <TextBlock Text="{Binding Body}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="Problem" Style="{StaticResource Caption}" Foreground="{DynamicResource Danger}"
                           Margin="4,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                <!--
                    Сведения сеткой: пресет, параметры подключения, автозапуск,
                    обновление. Двумя колонками на широком окне, одной — на узком
                    (HomeGrid, кодом по ширине).
                -->
                <TextBlock Text="Сведения" Style="{StaticResource SectionTitle}" Margin="2,22,0,12" />

                <Grid x:Name="InfoGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Текущий пресет. -->
                    <Border x:Name="CardPreset" Grid.Row="0" Grid.Column="0" Style="{StaticResource HomeCard}">
                        <StackPanel>
                            <TextBlock Text="Текущий пресет" Style="{StaticResource Caption}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE9E9;" Foreground="{DynamicResource Accent}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="PresetValue" FontSize="15" FontWeight="SemiBold" Text="—"
                                               TextTrimming="CharacterEllipsis" />

                                    <!--
                                        Первая фраза описания из самого файла пресета
                                        («# Description:»), в две строки. Своих описаний
                                        не придумываем: пресеты меняются выпусками,
                                        и придуманное разошлось бы с файлом.
                                    -->
                                    <TextBlock x:Name="PresetNote" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />
                                </StackPanel>

                                <!--
                                    Смена пресета — тем же, чем в «Десинке»: запись
                                    PresetName и предложение перезапустить.
                                -->
                                <Button Grid.Column="2" x:Name="PresetMenu" Style="{StaticResource Ghost}"
                                        Padding="12,7" Margin="10,0,0,0" VerticalAlignment="Top" Click="OnPresetMenu">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Изменить" VerticalAlignment="Center" />
                                        <Path Style="{StaticResource Chevron}" Margin="10,1,0,0">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="90" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Параметры подключения. Только показ: правка — в своих разделах. -->
                    <Border x:Name="CardParams" Grid.Row="0" Grid.Column="2" Style="{StaticResource HomeCard}">
                        <StackPanel>
                            <TextBlock Text="Параметры подключения" Style="{StaticResource Caption}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource LineGlyph}" Text="&#xE8CE;" Margin="0,0,0,9" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Caption}" Text="Сервер"
                                           Margin="0,0,14,9" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="ServerValue" Text="—" Margin="0,0,0,9"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Style="{StaticResource LineGlyph}" Text="&#xE774;" Margin="0,0,0,9" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Caption}" Text="DNS"
                                           Margin="0,0,14,9" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="DnsValue" Text="—" Margin="0,0,0,9"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="2" Style="{StaticResource LineGlyph}" Text="&#xE7C3;" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Caption}" Text="Подписки"
                                           Margin="0,0,14,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="SubscriptionValue" Text="—"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Автозапуск. -->
                    <Border x:Name="CardAutostart" Grid.Row="2" Grid.Column="0" Style="{StaticResource HomeCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,14,0">
                                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE945;" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Автозапуск" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Задача планировщика, а не служба: правами администратора задача наделяется сразу, запрос UAC при входе не появляется. Запускается та же программа и с теми же ключами, что и кнопка «Запустить», — иначе автозапуск поднимал бы не то, что вы проверили руками." />
                                </StackPanel>

                                <!--
                                    Что именно поднимется — теми же словами, какими
                                    это задано режимом. Своего выбора у автозапуска
                                    нет намеренно: он был бы вторым местом, где
                                    решают одно и то же.
                                -->
                                <TextBlock x:Name="AutostartRaises" Style="{StaticResource Caption}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />

                                <TextBlock x:Name="AutostartValue" Style="{StaticResource Caption}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>

                            <!--
                                Выключатель, а не кнопка «Завести/Убрать»: щелчок
                                заводит или убирает задачу, а положение затем
                                ставится по ответу планировщика, не по щелчку.
                            -->
                            <ToggleButton Grid.Column="2" x:Name="AutostartSwitch" Style="{StaticResource Switch}"
                                          Click="OnAutostart" VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <!-- Обновление. -->
                    <views:UpdatePanel x:Name="Updates" Grid.Row="2" Grid.Column="2" />
                </Grid>

                <!--
                    Блок поддержки — внизу, одной ненавязчивой полосой.
                    Прячется навсегда по «Скрыть» (SupportCardHidden) и
                    показывается только после мастера первого запуска.
                -->
                <Border x:Name="SupportCard" Style="{StaticResource Card}" Margin="0,16,0,0"
                        Padding="18,12,12,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource LineGlyph}" Text="&#xE735;"
                                   FontSize="18" Foreground="{DynamicResource Warn}"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                                       Text="Нравится Zephyron? Поставьте звезду, подпишитесь на канал или поддержите донатом" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Так о программе узнают другие, а вы — о новых версиях. Донат — на развитие проекта." />
                        </StackPanel>

                        <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Style="{StaticResource Ghost}" Click="OnStar" Margin="0,0,8,0"
                                    ToolTip="Страница Zephyron на GitHub — звезда справа вверху">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE734;" Margin="0,0,8,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Звезда на GitHub" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Ghost}" Click="OnTelegram" Margin="0,0,8,0"
                                    ToolTip="Новости в телеграм-канале">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE724;" Margin="0,0,8,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Канал" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Ghost}" Click="OnSupport" Margin="0,0,8,0"
                                    ToolTip="Поддержать разработку донатом">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xEB51;" Margin="0,0,8,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Поддержать" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Ghost}" Click="OnSupportHide" Content="Скрыть"
                                    ToolTip="Больше не показывать" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
